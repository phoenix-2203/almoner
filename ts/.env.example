# Testnet only. Create an account and get NEAR at https://testnet.mynearwallet.com
# or: near account create-account sponsor-by-faucet-service <name>.testnet autogenerate-new-keypair save-to-legacy-keychain network-config testnet create
# The account needs about 9 NEAR (contract storage + seller/agent gas).
OWNER_ACCOUNT_ID=yourname.testnet
OWNER_PRIVATE_KEY=ed25519:...
NEAR_NETWORK=testnet
